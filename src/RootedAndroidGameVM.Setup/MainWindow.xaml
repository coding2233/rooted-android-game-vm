<Window x:Class="RootedAndroidGameVM.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 Rooted Android Game VM" Width="1000" Height="760" MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Segoe UI" Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#172033">
            <Grid Margin="32,36,28,30">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="48" Height="48" Background="#5865F2" CornerRadius="13" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Rooted Android&#x0a;Game VM" Foreground="White" FontSize="24" FontWeight="SemiBold" LineHeight="31" Margin="0,18,0,0" />
                    <TextBlock Text="一次安装，之后从桌面直接启动。" Foreground="#BFC7D7" FontSize="13" Margin="0,10,0,0" />
                </StackPanel>
                <ItemsControl x:Name="StageList" Grid.Row="2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#2B354A" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Number}" Foreground="#CBD2E0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Caption}" Foreground="#9FA9BC" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="3" Text="Windows 11 x64 · Android 15 · Root" Foreground="#8792A6" FontSize="11" />
            </Grid>
        </Border>
        <DockPanel Grid.Column="1" Margin="38,34,38,30">
            <Grid DockPanel.Dock="Bottom" Margin="0,22,0,0">
                <Button x:Name="ExitButton" Style="{StaticResource SecondaryButton}" Content="退出" Width="88" HorizontalAlignment="Left" Click="Exit_Click" />
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="开始安装" MinWidth="140" HorizontalAlignment="Right" Click="Install_Click" AutomationProperties.Name="开始安装" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock x:Name="HeadingText" Text="安装到这台电脑" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="准备安卓运行环境、创建虚拟机并验证 Root 权限。" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,9,0,0" TextWrapping="Wrap" />
                    <Border Background="#F6F7FB" CornerRadius="14" Padding="20" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="资源存储位置" FontSize="15" FontWeight="SemiBold" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ResourcePathTextBox" Padding="9" FontSize="13" BorderBrush="#D6DCE6" BorderThickness="1" VerticalContentAlignment="Center" AutomationProperties.Name="资源存储位置" />
                                <Button x:Name="BrowseResourceButton" Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}" Height="38" Width="78" Margin="9,0,0,0" Click="BrowseResource_Click" AutomationProperties.Name="选择资源文件夹" />
                            </Grid>
                            <TextBlock x:Name="StorageDescriptionText" Text="下载缓存、运行环境、模拟器和应用数据均保存在这里。可选择其他磁盘上的空文件夹。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Expander Header="高级：复用已有 Android SDK（可选）" Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource InkBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="选择本机已安装的 Android SDK。产品只核验系统镜像与 Root，不会改写它；缺少 cmdline-tools 时会补装。留空则使用产品自管 SDK。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="SdkPathTextBox" Padding="9" FontSize="13" BorderBrush="#D6DCE6" BorderThickness="1" VerticalContentAlignment="Center" AutomationProperties.Name="外部 Android SDK 文件夹" />
                                <Button x:Name="BrowseSdkButton" Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}" Height="38" Width="78" Margin="9,0,0,0" Click="BrowseSdk_Click" AutomationProperties.Name="选择外部 Android SDK" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Expander Header="下载来源与本地导入（可选）" Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource InkBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock x:Name="DownloadStatusText" Text="正在检查组件缓存…" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="ImportDownloadsButton" Content="从本地文件夹导入组件…" Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" Click="ImportDownloads_Click" AutomationProperties.Name="导入已下载组件" />
                                <Button x:Name="ChinaPresetButton" Content="填入国内镜像预设" Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" Margin="8,0,0,0" Click="ChinaPreset_Click" AutomationProperties.Name="填入国内镜像预设" />
                                <Button x:Name="ClearMirrorButton" Content="清除镜像" Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" Margin="8,0,0,0" Click="ClearMirror_Click" AutomationProperties.Name="清除下载镜像" />
                            </WrapPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="CachePathText" Text="下载缓存：" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="打开缓存目录" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="8,0,0,0" Click="OpenCache_Click" AutomationProperties.Name="打开下载缓存目录" />
                                <Button Grid.Column="2" Content="复制全部链接" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="6,0,0,0" Click="CopyAllLinks_Click" AutomationProperties.Name="复制全部下载链接" />
                            </Grid>
                            <ItemsControl x:Name="DownloadLinkList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,6" BorderBrush="#E3E7EF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBox Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="11" Foreground="#3A4A63" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.Name="组件下载链接" />
                                                    <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Content="复制" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Click="CopyLink_Click" Tag="{Binding Url}" AutomationProperties.Name="复制下载链接" />
                                                    <Button Content="打开" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Margin="6,0,0,0" Click="OpenLink_Click" Tag="{Binding Url}" AutomationProperties.Name="打开下载链接" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="把自行下载的文件放进任意文件夹后，点上面的“从本地文件夹导入组件”即可；只接受 SHA-256 匹配的文件。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="镜像前缀（可选，填写后替换对应来源前缀；仍强制 SHA-256 校验，镜像无法替换内容）：" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,4" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Google 下载" VerticalAlignment="Center" FontSize="12" />
                                <TextBox x:Name="GoogleMirrorTextBox" Grid.Column="1" Padding="8" FontSize="12" BorderBrush="#D6DCE6" BorderThickness="1" VerticalContentAlignment="Center" AutomationProperties.Name="Google 下载镜像前缀" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="GitHub 下载" VerticalAlignment="Center" FontSize="12" />
                                <TextBox x:Name="GitHubMirrorTextBox" Grid.Column="1" Padding="8" FontSize="12" BorderBrush="#D6DCE6" BorderThickness="1" VerticalContentAlignment="Center" AutomationProperties.Name="GitHub 下载镜像前缀" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Microsoft 下载" VerticalAlignment="Center" FontSize="12" />
                                <TextBox x:Name="MicrosoftMirrorTextBox" Grid.Column="1" Padding="8" FontSize="12" BorderBrush="#D6DCE6" BorderThickness="1" VerticalContentAlignment="Center" AutomationProperties.Name="Microsoft 下载镜像前缀" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Border Background="#F6F7FB" CornerRadius="14" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock x:Name="ProgressTitleText" Text="准备安装" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ProgressDetailText" Text="选择资源位置后，点击“开始安装”。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="0%" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,18,0,0" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Background="#E3E7EF" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F6F7FB" CornerRadius="14" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="安装进度" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="ElapsedText" Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </Grid>
                            <TextBlock x:Name="StageText" Text="等待开始" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <ItemsControl x:Name="ProgressList" Margin="0,12,0,0" AutomationProperties.Name="安装进度明细">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Percent}" Margin="0,4,0,0" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Background="#E3E7EF" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Top" MinWidth="56" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="包含桌面启动器、APK 安装和数据导出工具。不会附带第三方 APK、账号或应用数据。" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,22,0,0" />
                    <CheckBox x:Name="LicenseCheckBox" VerticalContentAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="我已阅读并接受 Android SDK 许可协议，允许安装器下载所需组件。" FontSize="12" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock x:Name="LicenseLinkText" Margin="24,6,0,0" FontSize="11"><Hyperlink NavigateUri="https://developer.android.com/studio/terms" RequestNavigate="LicenseLink_RequestNavigate">在浏览器中查看 Android SDK 许可协议</Hyperlink></TextBlock>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
